{
  "name": "axethrow-scoreboard",
  "version": "0.1.0",
  "private": true,
  "description": "Axe-throwing venue scoreboard app for Android tablets (Target, Connect 4, Tic-Tac-Toe). Local-only, no server, no database.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:add:android": "cap add android",
    "android:live": "npm run build && cross-env CAP_LIVE=1 cap sync android",
    "android:offline": "npm run build && cap sync android"
  },
  "keywords": [
    "axe-throwing",
    "scoreboard",
    "kiosk",
    "android",
    "capacitor"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "bad-words": "^4.1.5"
  }
}
